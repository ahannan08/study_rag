DATABASE_URL=postgresql+psycopg2://study:study@localhost:5432/study_rag
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- LLM (pick one provider) ---
# Groq: https://console.groq.com — key starts with gsk_
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Alternatives: llama-3.3-70b-versatile, llama-3.1-8b-instant

# xAI Grok Cloud: https://console.x.ai — key starts with xai-
# LLM_PROVIDER=xai
# XAI_API_KEY=
# XAI_MODEL=grok-build-0.1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=./data
FAISS_DIR=./data/faiss
UPLOAD_DIR=./data/uploads
RETRIEVAL_TOP_K=5
COVERAGE_FULL_THRESHOLD=0.75
COVERAGE_PARTIAL_THRESHOLD=0.5
WEAK_POINT_ERROR_THRESHOLD=0.4
GROK_TIMEOUT_SECONDS=120
